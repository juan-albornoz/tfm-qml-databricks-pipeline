# ============================================================
# .gitignore — tfm-qml-databricks-pipeline
# ============================================================

# Datos — nunca subir datos NHANES (licencia CDC)
*.xpt
*.parquet
*.csv

# Modelos entrenados — archivos pesados
*.pkl
*.onnx
*.npy

# Figuras generadas — se regeneran desde los notebooks
# *.png — ver excepcion abajo
*.jpg
*.jpeg

# Python
__pycache__/
*.py[cod]
*.egg-info/
.env
.env.*
venv/
.venv/

# Secretos / credenciales — NUNCA subir
.streamlit/secrets.toml
secrets.toml
*.pem
*.key
credentials
.aws/
aws_credentials

# Jupyter checkpoints
.ipynb_checkpoints/

# IDEs
.vscode/
.idea/

# Databricks
.databricks/

# OS
.DS_Store
Thumbs.db

# Figuras del proyecto — incluir carpeta figures/

# Excepción: los modelos ONNX y arrays .npy del Live Predictor SÍ deben subir
!streamlit/models/*.onnx
!streamlit/models/*.npy
