# ============================================================
# .gitignore — tfm-qml-databricks-pipeline
# ============================================================

# Datos — nunca subir datos NHANES (licencia CDC)
*.xpt
*.parquet
*.csv

# Modelos entrenados — archivos pesados
*.pkl
*.onnx
*.npy

# Figuras generadas — se regeneran desde los notebooks
# *.png — ver excepcion abajo
*.jpg
*.jpeg

# Python
__pycache__/
*.py[cod]
*.egg-info/
.env
.env.*
venv/
.venv/

# Copias de seguridad locales del dashboard. El historial de git YA es la copia de
# seguridad de app.py; una segunda copia dentro del repo solo añade un fichero de
# 100 KB que se desincroniza en cuanto se toca el original, y que ademas confunde a
# las busquedas — grep encuentra dos veces cada funcion, una de ellas obsoleta.
# Se ignora por ruta exacta y no con un patron tipo *_BACKUP.py: asi no puede tapar
# en silencio un fichero futuro que si haga falta versionar.
streamlit/app_ORIGINAL_BACKUP.py

# Secretos / credenciales — NUNCA subir
.streamlit/secrets.toml
secrets.toml
*.pem
*.key
credentials
.aws/
aws_credentials

# Jupyter checkpoints
.ipynb_checkpoints/

# IDEs
.vscode/
.idea/

# Databricks
.databricks/

# OS
.DS_Store
Thumbs.db

# Figuras del proyecto — incluir carpeta figures/

# Excepción: los modelos ONNX y arrays .npy del Live Predictor SÍ deben subir
!streamlit/models/*.onnx
!streamlit/models/*.npy

# Excepción: el resumen de la suite de calidad que genera el NB07. No son datos NHANES
# (son 9 cifras agregadas de la validación), y la página Gobernanza lo lee si está
# presente en vez de llevar las cifras transcritas a mano.
!streamlit/models/validacion_silver_dfe.csv

# Excepción: los "golden sets" que generan el NB04 y el NB05 — 25 filas del test con la
# probabilidad que produjo el modelo entrenado. Sirven para que el dashboard verifique de
# punta a punta su propio camino de inferencia (escalado incluido) contra los notebooks.
# Son 25 de 7.831 registros ya anonimizados por NHANES, sin SEQN ni identificadores.
!streamlit/models/golden_*.npz
